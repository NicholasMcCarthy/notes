#!/usr/bin/env bash
set -euo pipefail

APP_NAME="notes"
VERSION="0.3.0"

CONFIG_DIR="${NOTES_CONFIG_DIR:-${XDG_CONFIG_HOME:-"$HOME/.config"}/notes-cli}"
CONFIG_FILE="${NOTES_CONFIG_FILE:-"$CONFIG_DIR/config"}"

load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck disable=SC1090
        . "$CONFIG_FILE"
    fi
}

load_config

NOTES_DATETIME_FORMAT="${NOTES_DATETIME_FORMAT:-%Y-%m-%d %H:%M:%S}"
DEFAULT_LIMIT="${NOTES_LIMIT:-${NOTES_DEFAULT_LIMIT:-15}}"
DATA_DIR="${NOTES_DIR:-${XDG_DATA_HOME:-"$HOME/.local/share"}/notes-cli}"
NOTES_FILE="${NOTES_FILE:-"$DATA_DIR/notes.tsv"}"
NOTES_SYNC_DIR="${NOTES_SYNC_DIR:-}"
NOTES_HOSTNAME="${NOTES_HOSTNAME:-$(hostname 2>/dev/null || printf 'unknown')}"

die() {
    printf '%s\n' "error: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
notes - a tiny CLI note taker

Usage:
  notes                         List recent notes
  notes add [-n NAME] [-t TAGS] NOTE...
  notes list [-l LIMIT] [-t TAG] [-H HOST]
  notes search [-l LIMIT] [-t TAG] [-H HOST] QUERY
  notes show ID_OR_NUMBER
  notes edit ID_OR_NUMBER
  notes update ID_OR_NUMBER [-n NAME] [-t TAGS]
  notes delete [-f] ID_OR_NUMBER
  notes configure
  notes config
  notes path
  notes migrate [OLD_NOTES_FILE]
  notes help

Legacy-compatible shortcuts:
  notes "quick note text"
  notes --name NAME "note text"
  notes --recent [LIMIT]
  notes --search QUERY
  notes --delete ID_OR_NUMBER
  notes --configure

Environment:
  NOTES_FILE=/path/to/notes.tsv         Override notes database path
  NOTES_CONFIG_FILE=/path/to/config     Override config file path
  NOTES_LIMIT=20                        Override default list/search limit
  EDITOR=nano                           Editor used by "notes edit"

Storage:
  TSV rows: id, timestamp, host, name, tags, content
EOF
}

init_db() {
    mkdir -p "$(dirname "$NOTES_FILE")"
    touch "$NOTES_FILE"
}

sync_to_dir() {
    if [ -n "$NOTES_SYNC_DIR" ]; then
        mkdir -p "$NOTES_SYNC_DIR"
        cp "$NOTES_FILE" "$NOTES_SYNC_DIR/notes.tsv"
    fi
}

sanitize_field() {
    # Keep the database one-line-per-note by removing tabs/newlines.
    printf '%s' "${1:-}" | tr '\t\r\n' '   ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

make_id() {
    local id attempt=0

    while :; do
        id="$(head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n')"
        if ! awk -F '\t' -v id="$id" '$1 == id { found = 1 } END { exit found ? 0 : 1 }' "$NOTES_FILE"; then
            printf '%s\n' "$id"
            return 0
        fi

        attempt=$((attempt + 1))
        [ "$attempt" -lt 20 ] || die "could not allocate note id"
    done
}

is_int() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

resolve_id_or_number() {
    local key="$1"
    local resolved

    # Prefer stable IDs.
    if awk -F '\t' -v id="$key" '$1 == id { found = 1 } END { exit found ? 0 : 1 }' "$NOTES_FILE"; then
        printf '%s\n' "$key"
        return 0
    fi

    # Allow the visible row number from list/search output.
    if is_int "$key"; then
        resolved="$(awk -F '\t' -v n="$key" 'NR == n { print $1; exit }' "$NOTES_FILE")"
        [ -n "$resolved" ] || die "no note at number $key"
        printf '%s\n' "$resolved"
        return 0
    fi

    die "note not found: $key"
}

render_rows() {
    printf '%-5s %-10s %-19s %-20s %-16s %s\n' "No." "ID" "Date" "Name" "Tags" "Note"
    printf '%-5s %-10s %-19s %-20s %-16s %s\n' "---" "--" "----" "----" "----" "----"

    # Input: NR \t id \t timestamp \t host \t name \t tags \t content
    awk -F '\t' '
        function trunc(s, n) {
            return length(s) > n ? substr(s, 1, n - 3) "..." : s
        }

        {
            printf "%-5s %-10s %-19s %-20s %-16s %s\n",
                $1, $2, $3, trunc($5, 20), trunc($6, 16), $7
        }
    '
}

add_cmd() {
    local name="Untitled"
    local tags=""
    local content=""
    local timestamp id

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -n|--name)
                [ "$#" -ge 2 ] || die "--name requires a value"
                name="$2"
                shift 2
                ;;
            -t|--tags)
                [ "$#" -ge 2 ] || die "--tags requires a value"
                tags="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done

    content="$*"

    # Supports: echo "long note" | notes add -n work
    if [ -z "$content" ] && [ ! -t 0 ]; then
        content="$(cat)"
    fi

    [ -n "$content" ] || die "empty note"

    timestamp="$(date "+$NOTES_DATETIME_FORMAT")"
    id="$(make_id)"
    name="$(sanitize_field "$name")"
    tags="$(sanitize_field "$tags")"
    content="$(sanitize_field "$content")"

    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$timestamp" "$NOTES_HOSTNAME" "$name" "$tags" "$content" >> "$NOTES_FILE"
    sync_to_dir
    printf 'Added %s\n' "$id"
}

list_cmd() {
    local limit="$DEFAULT_LIMIT"
    local tag_filter=""
    local host_filter=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -l|--limit)
                [ "$#" -ge 2 ] || die "--limit requires a value"
                limit="$2"
                shift 2
                ;;
            -t|--tag)
                [ "$#" -ge 2 ] || die "--tag requires a value"
                tag_filter="$2"
                shift 2
                ;;
            -H|--host)
                [ "$#" -ge 2 ] || die "--host requires a value"
                host_filter="$2"
                shift 2
                ;;
            *)
                if is_int "$1"; then
                    limit="$1"
                    shift
                else
                    die "unknown list option: $1"
                fi
                ;;
        esac
    done

    is_int "$limit" || die "limit must be an integer"

    awk -F '\t' -v tag="$tag_filter" -v host="$host_filter" '
        function has_tag(tags, t,    n, a, i) {
            n = split(tags, a, /[, ]+/)
            for (i = 1; i <= n; i++)
                if (tolower(a[i]) == tolower(t)) return 1
            return 0
        }
        (tag == "" || has_tag($5, tag)) && (host == "" || tolower($3) == tolower(host)) {
            print NR "\t" $0
        }
    ' "$NOTES_FILE" | tail -n "$limit" | render_rows
}

search_cmd() {
    local limit="$DEFAULT_LIMIT"
    local query=""
    local tag_filter=""
    local host_filter=""
    local positional=()

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -l|--limit)
                [ "$#" -ge 2 ] || die "--limit requires a value"
                limit="$2"
                shift 2
                ;;
            -t|--tag)
                [ "$#" -ge 2 ] || die "--tag requires a value"
                tag_filter="$2"
                shift 2
                ;;
            -H|--host)
                [ "$#" -ge 2 ] || die "--host requires a value"
                host_filter="$2"
                shift 2
                ;;
            --)
                shift
                positional+=("$@")
                break
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    query="${positional[*]:-}"
    [ -n "$query" ] || die "search query required"
    is_int "$limit" || die "limit must be an integer"

    awk -F '\t' -v q="$query" -v limit="$limit" -v tag="$tag_filter" -v host="$host_filter" '
        function has_tag(tags, t,    n, a, i) {
            n = split(tags, a, /[, ]+/)
            for (i = 1; i <= n; i++)
                if (tolower(a[i]) == tolower(t)) return 1
            return 0
        }

        BEGIN { q = tolower(q) }

        index(tolower($0), q) > 0 && (tag == "" || has_tag($5, tag)) \
            && (host == "" || tolower($3) == tolower(host)) {
            matches[++count] = NR "\t" $0
        }

        END {
            start = count - limit + 1
            if (start < 1) start = 1

            for (i = start; i <= count; i++) {
                if (i in matches) print matches[i]
            }
        }
    ' "$NOTES_FILE" | render_rows
}

show_cmd() {
    local id
    [ "$#" -ge 1 ] || die "show requires an ID or number"
    id="$(resolve_id_or_number "$1")"

    awk -F '\t' -v id="$id" '
        $1 == id {
            printf "ID:      %s\n", $1
            printf "Date:    %s\n", $2
            printf "Host:    %s\n", $3
            printf "Name:    %s\n", $4
            printf "Tags:    %s\n", $5
            printf "Content: %s\n", $6
            found = 1
        }

        END { exit found ? 0 : 1 }
    ' "$NOTES_FILE" || die "note not found: $1"
}

delete_cmd() {
    local id tmp force=0 reply

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--force)
                force=1
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    [ "$#" -ge 1 ] || die "delete requires an ID or number"
    id="$(resolve_id_or_number "$1")"

    if [ "$force" -eq 0 ] && [ -t 0 ]; then
        printf 'Delete note %s? [y/N]: ' "$id" >&2
        IFS= read -r reply || true
        case "${reply:-}" in
            y|Y|yes|YES) ;;
            *) printf 'Cancelled.\n'; return 0 ;;
        esac
    fi

    tmp="$(mktemp)"
    awk -F '\t' -v id="$id" '$1 != id' "$NOTES_FILE" > "$tmp"
    mv "$tmp" "$NOTES_FILE"
    sync_to_dir

    printf 'Deleted %s\n' "$id"
}

edit_cmd() {
    local id tmp current updated db_tmp
    [ "$#" -ge 1 ] || die "edit requires an ID or number"
    id="$(resolve_id_or_number "$1")"

    current="$(awk -F '\t' -v id="$id" '$1 == id { print $6; exit }' "$NOTES_FILE")"
    tmp="$(mktemp)"
    printf '%s\n' "$current" > "$tmp"

    "${EDITOR:-vi}" "$tmp"

    updated="$(sanitize_field "$(cat "$tmp")")"
    rm -f "$tmp"

    [ -n "$updated" ] || die "edited note would be empty"

    db_tmp="$(mktemp)"
    awk -F '\t' -v OFS='\t' -v id="$id" -v updated="$updated" '
        $1 == id { $6 = updated }
        { print }
    ' "$NOTES_FILE" > "$db_tmp"

    mv "$db_tmp" "$NOTES_FILE"
    sync_to_dir
    printf 'Updated %s\n' "$id"
}

update_cmd() {
    local id new_name="" new_tags="" set_name=0 set_tags=0 db_tmp
    [ "$#" -ge 1 ] || die "update requires an ID or number"

    # Parse trailing options after the ID/number.
    local key="$1"
    shift

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -n|--name)
                [ "$#" -ge 2 ] || die "--name requires a value"
                new_name="$2"
                set_name=1
                shift 2
                ;;
            -t|--tags)
                [ "$#" -ge 2 ] || die "--tags requires a value"
                new_tags="$2"
                set_tags=1
                shift 2
                ;;
            *)
                die "unknown update option: $1"
                ;;
        esac
    done

    [ "$set_name" -eq 1 ] || [ "$set_tags" -eq 1 ] || die "update requires --name and/or --tags"

    id="$(resolve_id_or_number "$key")"
    new_name="$(sanitize_field "$new_name")"
    new_tags="$(sanitize_field "$new_tags")"

    db_tmp="$(mktemp)"
    awk -F '\t' -v OFS='\t' -v id="$id" \
        -v new_name="$new_name" -v set_name="$set_name" \
        -v new_tags="$new_tags" -v set_tags="$set_tags" '
        $1 == id {
            if (set_name) $4 = new_name
            if (set_tags) $5 = new_tags
        }
        { print }
    ' "$NOTES_FILE" > "$db_tmp"

    mv "$db_tmp" "$NOTES_FILE"
    sync_to_dir
    printf 'Updated %s\n' "$id"
}

config_cmd() {
    local count
    count="$(wc -l < "$NOTES_FILE" | tr -d ' ')"
    printf 'Notes:            %s\n' "$count"
    printf 'Notes file:       %s\n' "$NOTES_FILE"
    printf 'Config file:      %s\n' "$CONFIG_FILE"
    printf 'Hostname:         %s\n' "$NOTES_HOSTNAME"
    printf 'Date/time format: %s\n' "$NOTES_DATETIME_FORMAT"
    printf 'Default limit:    %s\n' "$DEFAULT_LIMIT"
    printf 'Sync directory:   %s\n' "${NOTES_SYNC_DIR:-not configured}"
}

write_config() {
    local datetime_format="$1"
    local default_limit="$2"
    local notes_file="$3"
    local sync_dir="$4"
    local tmp

    mkdir -p "$CONFIG_DIR"
    tmp="$(mktemp)"

    {
        printf '# notes-cli config\n'
        printf '# Generated by: notes configure\n\n'
        printf 'NOTES_DATETIME_FORMAT=%q\n' "$datetime_format"
        printf 'NOTES_DEFAULT_LIMIT=%q\n' "$default_limit"
        printf 'NOTES_FILE=%q\n' "$notes_file"
        printf 'NOTES_SYNC_DIR=%q\n' "$sync_dir"
    } > "$tmp"

    mv "$tmp" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

ask_with_default() {
    local prompt="$1"
    local default="$2"
    local reply

    printf '%s [%s]: ' "$prompt" "$default" >&2
    IFS= read -r reply || true
    printf '%s\n' "${reply:-$default}"
}

configure_cmd() {
    local datetime_format default_limit notes_file sync_dir

    cat >&2 <<EOF
notes configuration

Press Enter to keep the current/default value.
EOF

    datetime_format="$(ask_with_default 'Date/time format for new notes' "$NOTES_DATETIME_FORMAT")"
    default_limit="$(ask_with_default 'Default list/search limit' "$DEFAULT_LIMIT")"
    is_int "$default_limit" || die "default limit must be an integer"

    notes_file="$(ask_with_default 'Notes database file' "$NOTES_FILE")"
    sync_dir="$(ask_with_default 'Sync directory (e.g. Google Drive/OneDrive folder, blank to disable)' "${NOTES_SYNC_DIR:-}")"

    write_config "$datetime_format" "$default_limit" "$notes_file" "$sync_dir"

    printf '\nSaved config to %s\n' "$CONFIG_FILE"
    printf 'Run: notes config\n'
}

migrate_cmd() {
    local old_file prefix
    old_file="${1:-"$HOME/.notes"}"
    [ -f "$old_file" ] || die "old notes file not found: $old_file"

    prefix="legacy-$(date '+%Y%m%d%H%M%S')"

    awk -F ' - ' -v OFS='\t' -v prefix="$prefix" -v host="$NOTES_HOSTNAME" '
        NF >= 3 {
            ts = $1
            name = $2
            content = $3

            for (i = 4; i <= NF; i++) {
                content = content " - " $i
            }

            gsub(/\t|\r|\n/, " ", ts)
            gsub(/\t|\r|\n/, " ", name)
            gsub(/\t|\r|\n/, " ", content)

            print prefix "-" NR, ts, host, name, "", content
        }
    ' "$old_file" >> "$NOTES_FILE"

    printf 'Migrated notes from %s into %s\n' "$old_file" "$NOTES_FILE"
}

main() {
    init_db

    if [ "$#" -eq 0 ]; then
        list_cmd
        exit 0
    fi

    case "$1" in
        add|a)
            shift
            add_cmd "$@"
            ;;
        list|ls|recent|--recent)
            shift
            list_cmd "$@"
            ;;
        search|s)
            shift
            search_cmd "$@"
            ;;
        --search)
            shift
            search_cmd "$@"
            ;;
        show|cat)
            shift
            show_cmd "$@"
            ;;
        edit|e)
            shift
            edit_cmd "$@"
            ;;
        update|u)
            shift
            update_cmd "$@"
            ;;
        delete|del|rm|--delete)
            shift
            delete_cmd "$@"
            ;;
        configure|--configure)
            shift
            configure_cmd "$@"
            ;;
        config)
            shift
            config_cmd "$@"
            ;;
        path)
            shift
            printf '%s\n' "$NOTES_FILE"
            ;;
        migrate)
            shift
            migrate_cmd "$@"
            ;;
        help|-h|--help)
            usage
            ;;
        version|--version)
            printf '%s %s\n' "$APP_NAME" "$VERSION"
            ;;
        --name|-n)
            # Legacy compatibility: notes --name work "some note"
            [ "$#" -ge 3 ] || die "--name requires NAME and note text"
            legacy_name="$2"
            shift 2
            add_cmd --name "$legacy_name" "$@"
            ;;
        *)
            # Legacy compatibility: notes "some quick note"
            add_cmd "$@"
            ;;
    esac
}

main "$@"
